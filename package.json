{
  "name": "holdem-gto-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "sdk:build": "tsc -p sdk && node sdk/build.mjs",
    "sdk:pack": "npm run sdk:build && cd sdk && npm pack --pack-destination ../release"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
